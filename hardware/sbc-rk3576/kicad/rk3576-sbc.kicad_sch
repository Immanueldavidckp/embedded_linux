    (effects (font (size 1.6 1.6)) (justify left))
    (uuid "4ee9a86f-6bed-50ee-8eec-e2f49723be31")
  )
  (text "Notes: Input is USB-C 5V/3A (Rd sink, no PD negotiation): ~15W budget. NVMe + full CPU/NPU load can exceed this; use a 5V/4A+ supply or add a PD controller (rev B). | RK806S-5 OTP fixes the power-up order of BUCK/LDO slots for RK3576. The b"
    (at 30 222 0)
    (effects (font (size 1.6 1.6)) (justify left))
