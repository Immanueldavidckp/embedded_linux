  )
  (text "                                  --> 4x TPS56x buck (2V0, 1V1, VDD2L 0.9V, M.2 3V3)"
    (at 30 162 0)
    (effects (font (size 1.6 1.6)) (justify left))
    (uuid "a390460c-0d71-5f43-a23c-4462a2b2b1dc")
  )
  (text "RK3576 (4xA72 + 4xA53, Mali-G52, 6TOPS NPU)"
    (at 30 168 0)
